// Generates supabase/seed.sql from the fake catalog in lib/products.ts.
// Run: npx tsx scripts/make-seed.mts
import { writeFileSync } from "node:fs";
import { products, samples } from "../lib/products";
const q = (v: unknown) => (v == null ? "null" : typeof v === "number" ? String(v) : `'${String(v).replace(/'/g, "''")}'`);
const arr = (a: string[]) => `array[${a.map(q).join(",")}]::text[]`;
const rows = [...products.map((p) => ({ p, sample: false })), ...samples.map((p) => ({ p, sample: true }))].map(({ p, sample }, i) =>
  `(${[q(p.slug), q(p.name), q(p.brand), q(p.category), q(p.scent), q(p.family), q(p.conc), q(p.size), q(p.price), q(p.mrp), q(p.tag), sample, q(p.top), q(p.heart), q(p.base), q(p.desc), arr(p.occasions), q(p.rating), q(p.reviews), q(p.sold), q(p.c1), q(p.c2), q(null), i].join(", ")})`);
const sql = `-- Generated by scripts/make-seed.mts from lib/products.ts. Do not edit by hand.
insert into products (slug, name, brand, category, scent, family, conc, size, price, mrp, tag, is_sample, top, heart, base, description, occasions, rating, review_count, sold, c1, c2, image_url, position) values
${rows.join(",\n")}
on conflict (slug) do update set name=excluded.name, brand=excluded.brand, category=excluded.category, scent=excluded.scent, family=excluded.family, conc=excluded.conc, size=excluded.size, price=excluded.price, mrp=excluded.mrp, tag=excluded.tag, is_sample=excluded.is_sample, top=excluded.top, heart=excluded.heart, base=excluded.base, description=excluded.description, occasions=excluded.occasions, rating=excluded.rating, review_count=excluded.review_count, sold=excluded.sold, c1=excluded.c1, c2=excluded.c2, position=excluded.position;
`;
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), sql);
console.log(`Wrote ${rows.length} rows to supabase/seed.sql`);
