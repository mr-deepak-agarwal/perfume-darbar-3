// Generates supabase/seed.sql from the catalog in lib/products.ts (built from the price list).
// Run: npx tsx scripts/make-seed.mts
import { writeFileSync } from "node:fs";
import { products } from "../lib/products";
const q = (v: unknown) => (v == null ? "null" : typeof v === "number" ? String(v) : `'${String(v).replace(/'/g, "''")}'`);
const arr = (a: string[]) => `array[${a.map(q).join(",")}]::text[]`;
const rows = products.map((p, i) =>
  `(${[q(p.slug), q(p.name), q(p.brand), q(p.category), q(p.scent), q(p.family), q(p.conc), q(p.size), q(p.price), q(p.mrp), q(p.tag), q(p.top), q(p.heart), q(p.base), q(p.desc), arr(p.occasions), q(p.rating), q(p.reviews), q(p.sold), q(p.c1), q(p.c2), q(null), i, q(JSON.stringify(p.variants)) + "::jsonb"].join(", ")})`);
const cols = "slug, name, brand, category, scent, family, conc, size, price, mrp, tag, top, heart, base, description, occasions, rating, review_count, sold, c1, c2, image_url, position, variants";
const upd = cols.split(", ").filter((c) => c !== "slug").map((c) => `${c}=excluded.${c}`).join(", ");
const sql = `-- Generated by scripts/make-seed.mts from lib/products.ts. Do not edit by hand.
-- Removes products from the old demo catalog, then loads the current list. Safe to re-run.
delete from products where slug not in (${products.map((p) => q(p.slug)).join(", ")});
insert into products (${cols}) values
${rows.join(",\n")}
on conflict (slug) do update set ${upd};
`;
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), sql);
console.log(`Wrote ${rows.length} rows to supabase/seed.sql`);
