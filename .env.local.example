# Copy to .env.local. Supabase: Project Settings -> API.
# Both values are safe to expose to the browser (the anon key is limited by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: base URL of the FastAPI backend. In local dev, /api/* is proxied to it.
# API_URL=http://localhost:8000
#
# NEVER put the service-role key in this file. It belongs only in backend/.env.
